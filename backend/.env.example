# Copy to backend/.env for local development. Placeholders only: never put real values in this file or in git.
# Production values live in the Render dashboard; docs/DEPLOY.md ("Every variable") says what each one is.
# Random values: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# development | test | production (production turns on every startup check in app/core/config.py)
ENVIRONMENT=development
# Postgres the API connects to; in production the vaulta_app role (no BYPASSRLS) on Neon's pooled host
DATABASE_URL=postgresql://vaulta@localhost:5432/vaulta
# Firebase Admin service-account JSON on one line; "{}" is enough for migrations
FIREBASE_SERVICE_ACCOUNT_JSON=
# Signs demo sessions and unsubscribe links (32+ random characters in production)
SECRET_KEY=
# X-Internal-Secret for /internal/* (hourly run, email worker); unset = /internal refuses everything
INTERNAL_SECRET=
# Wraps each user's data key (AES-256-GCM); 32+ random characters, required everywhere; back it up offline
MASTER_KEY=
# Keys the blind indexes (HMAC); 32+ random characters, different from MASTER_KEY
BLIND_INDEX_KEY=
# The old MASTER_KEY, only while scripts/rotate_master_key.py runs
MASTER_KEY_PREVIOUS=
# Phase 4 Fernet key, read only by migration f6a2c8e0b1d3 if old forwarding tokens exist
ENCRYPTION_KEY=
# Comma-separated web app origins allowed by CORS (production: https only)
BACKEND_CORS_ORIGINS=http://localhost:5173
# Optional full-match regex for extra origins; leave unset in production
BACKEND_CORS_ORIGIN_REGEX=
# The web app's URL, for links in emails and Telegram
APP_BASE_URL=http://localhost:5173
# The API's URL, for unsubscribe links
API_BASE_URL=http://localhost:8000
# Published at the API's /.well-known/security.txt (required in production)
SECURITY_CONTACT_EMAIL=
# How recent a sign-in sensitive actions need, in seconds (production: 60-600)
RECENT_LOGIN_SECONDS=300
# reCAPTCHA v3 secret key; unset = tokens can't be checked and requests pass (logged)
RECAPTCHA_SECRET_KEY=
# true = refuse missing or forged tokens; false = monitor mode (log only)
RECAPTCHA_ENFORCE=false
# Below this score a request is slowed down, never refused for the score alone
RECAPTCHA_MIN_SCORE=0.5
# Local runs and browser tests only; production refuses to start with it
RECAPTCHA_DEBUG_TOKEN=
# false = rule-based categories only, no merchant model
MERCHANT_MODEL_ENABLED=true
# New demo sessions per client IP per 10 minutes
DEMO_SESSIONS_PER_IP=30
# Sentry DSN for the API; unset = no error reports
SENTRY_DSN=
# Groq API key for chat and report summaries; unset = chat says AI isn't configured, summaries use a template
GROQ_API_KEY=
# Any Groq chat model with tool calling
GROQ_MODEL=openai/gpt-oss-120b
# OpenAI-compatible chat completions endpoint (browser tests point it at a local fake)
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
# Resend API key for report, alert and account emails; unset = no email
RESEND_API_KEY=
# Sender, on a domain verified in Resend, e.g. "vaulta.in <noreply@example.com>"
EMAIL_FROM=
# Your domain; forwarding addresses become <token>@in.<INBOUND_DOMAIN>
INBOUND_DOMAIN=
# Telegram bot token from @BotFather; unset = no bot
TELEGRAM_BOT_TOKEN=
# The bot's username, without @
TELEGRAM_BOT_USERNAME=
# setWebhook secret_token, checked on every update (32+ characters: letters, digits, _ and -)
TELEGRAM_WEBHOOK_SECRET=
# Razorpay subscriptions (unset = payments off): key id, key secret, webhook secret and plan id
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=

# Not read from this file (the settings refuse unknown names in .env). Set in your shell when needed:
#   MIGRATION_DATABASE_URL       migrations and key rotation, from your machine: the tables' owner on the direct host
#   TEST_DATABASE_URL            backend tests' database (default postgresql://vaulta@localhost:54329/vaulta_test; local only)
#   FIREBASE_AUTH_EMULATOR_HOST  e.g. 127.0.0.1:9099, to check sign-ins against the local Firebase Auth emulator
#   RENDER_GIT_COMMIT            set by Render; tags Sentry reports with the deployed commit
