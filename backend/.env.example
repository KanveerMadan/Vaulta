# Copy to backend/.env for local development. Names only: never put real values in this file or in git.
# Production values live in the Render dashboard; docs/deploy.md says what each one is and how to make it.
# Random values: python3 -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=development
DATABASE_URL=postgresql://vaulta@localhost:5432/vaulta
FIREBASE_SERVICE_ACCOUNT_JSON=
SECRET_KEY=
INTERNAL_SECRET=
MASTER_KEY=
BLIND_INDEX_KEY=
MASTER_KEY_PREVIOUS=
BACKEND_CORS_ORIGINS=http://localhost:5173
BACKEND_CORS_ORIGIN_REGEX=
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
SECURITY_CONTACT_EMAIL=
RECENT_LOGIN_SECONDS=300
APP_CHECK_ENFORCE=false
APP_CHECK_DEBUG_TOKEN=
MERCHANT_MODEL_ENABLED=true
DEMO_SESSIONS_PER_IP=30
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
RESEND_API_KEY=
EMAIL_FROM=
INBOUND_DOMAIN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=
