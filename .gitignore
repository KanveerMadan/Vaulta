frontend/.env.local

# Backend
backend/venv/
backend/.env
__pycache__/
*.pyc

# OS
.DS_Store

# IDE
.vscode/
.idea/

# Environment files: never commit real values. .env.e2e holds only fake test values.
.env*
!.env.example
!frontend/.env.e2e

# Real statements or alert emails kept for local testing
local-statements/

# ML: local environment, and real data (never committed; see ml/README.md)
ml/.venv/
ml/data/private/
# generated by `make data` (deterministic)
ml/data/narrations.jsonl
ml/data/merchant_list.jsonl
ml/data/labels.jsonl
ml/artifacts/merchant_model.json

# Secrets and credentials: never in git (SECURITY.md). Env files are covered above.
*.env
*.token
*.pem
*.key
*.p12
secrets/
*-secrets/
*-secrets.env
*firebase-adminsdk*.json
service-account*.json
*backup-key*.txt
*.dump
*.dump.age

# Build and test output
dist/
dist-*/
dev-dist/
.wrangler/
.vercel/
test-results/
playwright-report/
.pytest_cache/
