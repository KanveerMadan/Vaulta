# Copy to frontend/.env.local for local development. Every VITE_* value is compiled into the public JavaScript, so
# none is a secret; production values are set in Vercel (docs/DEPLOY.md). Browser tests use .env.e2e instead.

# The API's URL; in production builds its origin must be in connect-src in vercel.json
VITE_API_BASE_URL=http://localhost:8000
# Firebase web app config (Firebase console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=
# Sign-in domain; in production the app's own domain, proxied to Firebase by vercel.json
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Security contact email, shown on /security and in /.well-known/security.txt (production build fails without it)
VITE_SECURITY_CONTACT=
# Privacy and grievance contact email, shown on /privacy (production build fails without it)
VITE_PRIVACY_CONTACT=
# reCAPTCHA v3 site key (public); unset = no token is sent
VITE_RECAPTCHA_SITE_KEY=
# Sentry DSN for the web app; unset = no error reports
VITE_SENTRY_DSN=
# Local runs and browser tests only, never in production builds:
# Firebase Auth emulator URL, e.g. http://127.0.0.1:9099
VITE_FIREBASE_AUTH_EMULATOR=
# Sent instead of a real reCAPTCHA token (ignored in production builds)
VITE_RECAPTCHA_DEBUG_TOKEN=
# How recent a sign-in sensitive actions need, in seconds (default 300)
VITE_RECENT_LOGIN_SECONDS=
