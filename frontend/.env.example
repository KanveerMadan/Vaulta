# Copy to frontend/.env.local for local development. Every VITE_* value is compiled into the public JavaScript, so
# none is a secret; production values are set in Vercel (docs/deploy.md).

VITE_API_BASE_URL=http://localhost:8000
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_SECURITY_CONTACT=
VITE_PRIVACY_CONTACT=
VITE_RECAPTCHA_SITE_KEY=
VITE_SENTRY_DSN=
# local runs and browser tests only, never in production builds
VITE_FIREBASE_AUTH_EMULATOR=
VITE_APPCHECK_DEBUG_TOKEN=
VITE_RECENT_LOGIN_SECONDS=
